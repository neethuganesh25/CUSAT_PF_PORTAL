    id            INT AUTO_INCREMENT PRIMARY KEY,
    username      VARCHAR(50)  NOT NULL UNIQUE,
    full_name     VARCHAR(100) NULL,
    password_hash VARCHAR(255) NOT NULL,        -- never the plain password
