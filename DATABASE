-- Monthly salary table


CREATE TABLE IF NOT EXISTS salary_monthly (
    id               BIGINT AUTO_INCREMENT PRIMARY KEY,
    emp_number       VARCHAR(20)  NOT NULL,          -- same value as employeemaster.emp_number
    pay_year         SMALLINT     NOT NULL,
    pay_month        TINYINT      NOT NULL,          -- 1 = Jan ... 12 = Dec
    basic_pay        DECIMAL(12,2) NULL,
    da               DECIMAL(12,2) NULL,
    hra              DECIMAL(12,2) NULL,
    other_allowances  DECIMAL(12,2) NULL,
    gross_salary     DECIMAL(12,2) NULL,
    pf_employee      DECIMAL(12,2) NULL,
    pf_employer      DECIMAL(12,2) NULL,
    net_salary       DECIMAL(12,2) NULL,
    UNIQUE KEY uq_emp_month (emp_number, pay_year, pay_month),
    INDEX idx_emp (emp_number)
) ENGINE=InnoDB;

