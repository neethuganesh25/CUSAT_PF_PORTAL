-- Login / activity log for the real employees table. Run once, after 01_employees.sql.

CREATE TABLE IF NOT EXISTS access_log (
    id          BIGINT AUTO_INCREMENT PRIMARY KEY,
    pf_no       VARCHAR(20)  NULL,    -- username: the employee number typed or logged in
    name        VARCHAR(150) NULL,    -- employee name (NULL if the number is unknown)
    event       ENUM('login_success','login_failed','login_blocked','view','download','logout') NOT NULL,
    created_at  DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_pf (pf_no), INDEX idx_time (created_at), INDEX idx_event (event)
) ENGINE=InnoDB;

-- One row per employee who has logged in.
CREATE OR REPLACE VIEW logged_in_employees AS
SELECT e.emp_number, e.emp_name, e.deptdetails, e.desgdetails,
       COUNT(*) AS total_logins, MIN(l.created_at) AS first_login, MAX(l.created_at) AS last_login
FROM access_log l
JOIN employeemaster e ON e.emp_number = l.pf_no
WHERE l.event = 'login_success'
GROUP BY e.emp_number, e.emp_name, e.deptdetails, e.desgdetails;

